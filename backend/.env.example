# ---- Database ----
# Local development uses SQLite and does not require a separate database server.
DATABASE_URL=sqlite:///./app/data/college_finance.db

# ---- Auth ----
# Generate a private value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_private_random_secret

# ---- Google Gemini (RAG generation) ----
GOOGLE_API_KEY=

# ---- Forecasting ----
FORECAST_ENGINE=arima
